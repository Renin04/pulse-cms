# ============================================================================
# Pulse CMS — Production Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Development (SQLite):
DATABASE_URL="file:./prisma/dev.db"

# Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/pulse"

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
# Generate strong secrets for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-in-production-min-32-chars-long"

# ----------------------------------------------------------------------------
# Storage (Media Uploads)
# ----------------------------------------------------------------------------
# Options: local | s3
STORAGE_TYPE="local"

# Local storage path (relative to project root)
# Files are served via /api/media/file/:id for access control
STORAGE_LOCAL_PATH="./uploads"

# Public base URL for media assets
# In production, use a CDN domain: https://cdn.yoursite.com/media
STORAGE_PUBLIC_URL="/api/media/file"

# S3-compatible storage (optional, for production)
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_REGION="us-east-1"
# S3_BUCKET="pulse-media"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_PUBLIC_URL="https://cdn.yoursite.com"

# ----------------------------------------------------------------------------
# Upload Limits
# ----------------------------------------------------------------------------
UPLOAD_MAX_SIZE="10485760"
UPLOAD_ALLOWED_TYPES="image/*,video/*,audio/*,application/pdf"

# ----------------------------------------------------------------------------
# Background Jobs / Cron
# ----------------------------------------------------------------------------
# Secret token for triggering background jobs via external cron service
CRON_SECRET="generate-a-strong-random-secret-for-cron"

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
# CORS origin for API routes (default: same-origin)
# API_CORS_ORIGIN="https://yoursite.com"

# Rate limit requests per window (default: 100 per 15 min)
# RATE_LIMIT_MAX="100"
# RATE_LIMIT_WINDOW_MS="900000"

# Token for the headless article publishing API (POST /api/cms/publish-article)
# Generate a strong random value; requests must send "Authorization: Bearer <token>"
CONTENT_API_TOKEN=""
# Public URL of the production site (used by scripts/publish-article.mjs --target prod)
PROD_SITE_URL="http://localhost:3000"
